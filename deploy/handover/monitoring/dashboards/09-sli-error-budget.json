{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "VictoriaMetrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "aspm-slo",
  "title": "ASPM SLIs & Error Budget",
  "description": "ASPM 1.0.1 · эксплуатационная телеметрия",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "aspm",
    "operations"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Источник",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "${DS_PROMETHEUS}",
          "value": "${DS_PROMETHEUS}"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "query": "label_values(up{application=\"aspm\"}, cluster)",
        "definition": "label_values(up{application=\"aspm\"}, cluster)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\"}, environment)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\"}, environment)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\"}, namespace)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "release",
        "label": "release",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\"}, release)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\"}, release)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "scanner",
        "label": "scanner",
        "type": "query",
        "query": "label_values(aspm_scan_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}, scanner)",
        "definition": "label_values(aspm_scan_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}, scanner)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Доступность и бизнес-SLI",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "title": "HTTP · доля не-5xx",
      "description": "HTTP SLI по Django, требует наблюдаемых запросов.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - aspm:http_5xx_ratio:rate5m{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "ScanRun · доля успеха",
      "description": "Успешные терминальные попытки / все терминальные попытки.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aspm_scan_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",scanner=~\"${scanner:regex}\",component=\"worker\",result=\"completed\"}[$__rate_interval])) / (sum(rate(aspm_scan_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",scanner=~\"${scanner:regex}\",component=\"worker\",result=~\"completed|failed\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "ScanRun · completion p90",
      "description": "Все наблюдаемые ScanRun. Acceptance workload 400 Findings проверяется отдельным тестом.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(aspm_scan_phase_seconds_bucket{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",scanner=~\"${scanner:regex}\",component=\"worker\",stage=\"acceptance_to_completion\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "s",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Generated reports · доля успеха",
      "description": "Успешные терминальные исходы / все терминальные исходы.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aspm_report_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",kind=\"generated\",result=\"generated\"}[$__rate_interval])) / (sum(rate(aspm_report_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",kind=\"generated\",result=~\"generated|failed\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Webhook · доля успешных попыток",
      "description": "Доля HTTP попыток с успешным сохранённым результатом.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aspm_webhook_delivery_attempts_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",outcome=\"success\"}[$__rate_interval])) / (sum(rate(aspm_webhook_delivery_attempts_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "percentunit",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Burn rate · HTTP",
      "description": "Иллюстративный бюджет 0,1%, требуется утверждение владельцем.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aspm:http_5xx_ratio:rate5m{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"} / 0.001",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      }
    }
  ],
  "links": [
    {
      "title": "ASPM dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "aspm"
      ]
    }
  ]
}
