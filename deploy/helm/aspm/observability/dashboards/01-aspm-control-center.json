      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_ready{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",deployment=~\".*-web\"})",
