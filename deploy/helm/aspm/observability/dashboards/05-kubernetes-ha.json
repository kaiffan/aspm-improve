    {
      "title": "PVC · объём и расход",
      "description": "Объём и расход от CSI/kubelet. Empty series означает отсутствие источника.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
