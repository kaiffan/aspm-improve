      }
    },
    {
      "title": "Memory requests / limits",
      "description": "Данные resource spec из kube-state-metrics.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_resource_requests{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",resource=\"memory\"}",
          "legendFormat": "{{pod}} {{container}} request",
