    {
      "title": "Traefik · ответы",
      "description": "Только разрешённые Traefik service labels.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code,service) (rate(traefik_service_requests_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}[$__rate_interval]))",
