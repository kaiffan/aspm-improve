        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "CPU requests / limits",
      "description": "Данные resource spec из kube-state-metrics.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_resource_requests{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",resource=\"cpu\"}",
          "legendFormat": "{{pod}} {{container}} request",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "kube_pod_container_resource_limits{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",resource=\"cpu\"}",
          "legendFormat": "{{pod}} {{container}} limit",
          "instant": false,
