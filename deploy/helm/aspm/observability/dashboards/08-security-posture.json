{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "VictoriaMetrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "aspm-security",
  "title": "ASPM Security Posture Overview",
  "description": "ASPM 1.0.1 · эксплуатационная телеметрия",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "aspm",
    "operations"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Источник",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "${DS_PROMETHEUS}",
          "value": "${DS_PROMETHEUS}"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "query": "label_values(up{application=\"aspm\"}, cluster)",
        "definition": "label_values(up{application=\"aspm\"}, cluster)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\"}, environment)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\"}, environment)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\"}, namespace)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "release",
        "label": "release",
        "type": "query",
        "query": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\"}, release)",
        "definition": "label_values(up{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\"}, release)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Агрегаты для SecOps",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "title": "Проекты",
      "description": "Все проекты. Требует opt-in securityPosture и доступа SecOps.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aspm_security_projects{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Репозитории",
      "description": "Все зарегистрированные репозитории.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aspm_security_repositories{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Активные Findings",
      "description": "Активные записи live Findings с исключением false positives, duplicates, out of scope и mitigated.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aspm_security_active_findings{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Нет данных",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "title": "Активные Findings по severity",
      "description": "Количество live Findings по каноническому severity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aspm_security_active_findings{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\"}",
          "legendFormat": "{{severity}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Активность сканеров",
      "description": "Завершения и ошибки по разрешённому каталогу сканеров за минуту.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scanner,result) (rate(aspm_scan_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",result=~\"completed|failed\"}[$__rate_interval])) * 60",
          "legendFormat": "{{scanner}} · {{result}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Отчёты, сгенерированные за час",
      "description": "Число сформированных отчётов в скользящий час.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind) (increase(aspm_report_events_total{application=\"aspm\",cluster=~\"${cluster:regex}\",environment=~\"${environment:regex}\",namespace=~\"${namespace:regex}\",release=~\"${release:regex}\",result=\"generated\"}[1h]))",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": []
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    }
  ],
  "links": [
    {
      "title": "ASPM dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "aspm"
      ]
    }
  ]
}
