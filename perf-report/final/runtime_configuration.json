{
  "application_version": "3.5.100",
  "django": "5.2.17",
  "drf": "3.18.3",
  "python": "3.14.8",
  "debug": false,
  "timezone": "UTC",
  "conn_max_age": 0,
  "cache_backend": "django.core.cache.backends.redis.RedisCache",
  "cache_namespace_isolated": true,
  "uwsgi": {
    "processes": "4",
    "threads": "4"
  },
  "features": {
    "V3_FEATURE_LOCATIONS": true,
    "ENABLE_V3_ORGANIZATION_ASSET_RELABEL": true
  },
  "postgres": {
    "server_version": "18.6",
    "shared_buffers": "128MB",
    "work_mem": "4MB",
    "max_connections": "100",
    "max_parallel_workers_per_gather": "2",
    "track_io_timing": "off",
    "effective_cache_size": "4GB"
  }
}
