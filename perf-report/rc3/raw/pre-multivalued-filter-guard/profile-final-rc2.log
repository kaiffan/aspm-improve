SQL {"actor": "admin", "case": "simple_metrics", "ms": 85.1406229994609, "sql": "SELECT DISTINCT \"dojo_finding\".\"severity\" AS \"severity\", COUNT(DISTINCT \"dojo_finding\".\"id\") AS \"count\" FROM \"dojo_finding\" INNER JOIN \"dojo_test\" ON (\"dojo_finding\".\"test_id\" = \"dojo_test\".\"id\") INNER JOIN \"dojo_engagement\" ON (\"dojo_test\".\"engagement_id\" = \"dojo_engagement\".\"id\") INNER JOIN \"dojo_product\" ON (\"dojo_engagement\".\"product_id\" = \"dojo_product\".\"id\") WHERE (EXTRACT(MONTH FROM \"dojo_finding\".\"date\") = %s AND \"dojo_finding\".\"date\" BETWEEN %s AND %s AND NOT \"dojo_finding\".\"duplicate\" AND NOT \"dojo_finding\".\"false_p\" AND NOT \"dojo_finding\".\"out_of_scope\" AND \"dojo_product\".\"prod_type_id\" = %s AND \"dojo_finding\".\"verified\") GROUP BY 1", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/metrics/views.py:215:simple_metrics"]}
