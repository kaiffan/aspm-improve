SQL {"actor": "small", "case": "fast_offset", "ms": 1.126964998547919, "sql": "SELECT COUNT(*) AS \"__count\" FROM \"dojo_finding\" WHERE \"dojo_finding\".\"test_id\" = ANY((ARRAY(SELECT V0.\"id\" AS \"pk\" FROM \"dojo_test\" V0 INNER JOIN \"dojo_engagement\" V1 ON (V0.\"engagement_id\" = V1.\"id\") WHERE V1.\"product_id\" IN (SELECT U0.\"id\" AS \"id\" FROM \"dojo_product\" U0 LEFT OUTER JOIN \"dojo_product_authorized_users\" U1 ON (U0.\"id\" = U1.\"product_id\") INNER JOIN \"dojo_product_type\" U3 ON (U0.\"prod_type_id\" = U3.\"id\") LEFT OUTER JOIN \"dojo_product_type_authorized_users\" U4 ON (U3.\"id\" = U4.\"product_type_id\") WHERE (U1.\"dojo_user_id\" = %s OR U4.\"dojo_user_id\" = %s)))))", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/api_v2/prefetch/mixins.py:17:list", "/app/dojo/finding/api/large_offset_pagination.py:46:paginate_queryset"]}
