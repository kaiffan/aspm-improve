SQL {"actor": "admin", "case": "reports", "ms": 6.65207299971371, "sql": "SELECT COUNT(*) FROM (SELECT DISTINCT \"dojo_location\".\"id\" AS \"col1\", \"dojo_location\".\"created\" AS \"col2\", \"dojo_location\".\"updated\" AS \"col3\", \"dojo_location\".\"location_type\" AS \"col4\", \"dojo_location\".\"location_value\" AS \"col5\", COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") AS \"total_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"total_findings\", COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"active_findings\", COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") AS \"total_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"total_products\", COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"active_products\", (COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") AS \"total_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) - COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s)) AS \"mitigated_findings\", CASE WHEN (COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) > %s OR COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) > %s) THEN %s ELSE %s END AS \"overall_status\" FROM \"dojo_location\" WHERE EXISTS(SELECT %s AS \"a\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\") AND V0.\"status\" = %s) LIMIT 1)) subquery", "stack": ["/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/reports/ui/views.py:94:get", "/app/dojo/reports/ui/views.py:140:get_context", "/app/dojo/reports/ui/views.py:129:get_available_widgets", "/app/dojo/reports/widgets.py:348:__init__", "/app/dojo/utils.py:914:get_page_items", "/app/dojo/utils.py:943:get_page_items_and_count"]}
