SQL {"actor": "admin", "case": "dashboard", "ms": 287.51806899890653, "sql": "SELECT (\"dojo_finding\".\"created\" AT TIME ZONE %s)::date AS \"created__date\", \"dojo_finding\".\"severity\" AS \"severity\", COUNT(\"dojo_finding\".\"severity\") AS \"count\", COUNT(\"dojo_finding\".\"id\") AS \"total\" FROM \"dojo_finding\" WHERE NOT \"dojo_finding\".\"duplicate\" GROUP BY 2, 1", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/home/views.py:49:dashboard", "/app/dojo/home/views.py:88:get_dashboard_chart_data"]}
SQL {"actor": "admin", "case": "dashboard", "ms": 0.1861669989011716, "sql": "SELECT COUNT(*) AS \"__count\" FROM \"dojo_alerts\" WHERE \"dojo_alerts\".\"user_id_id\" = %s", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/home/views.py:59:dashboard", "/app/dojo/notifications/context_processors.py:12:bind_alert_count"]}
SQL {"actor": "admin", "case": "dashboard", "ms": 0.17512599879410118, "sql": "SELECT \"dojo_userannouncement\".\"id\", \"dojo_userannouncement\".\"announcement_id\", \"dojo_userannouncement\".\"user_id\", \"dojo_announcement\".\"id\", \"dojo_announcement\".\"message\", \"dojo_announcement\".\"style\", \"dojo_announcement\".\"dismissable\" FROM \"dojo_userannouncement\" LEFT OUTER JOIN \"dojo_announcement\" ON (\"dojo_userannouncement\".\"announcement_id\" = \"dojo_announcement\".\"id\") WHERE \"dojo_userannouncement\".\"user_id\" = %s LIMIT 21", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/home/views.py:59:dashboard", "/app/dojo/context_processors.py:101:bind_announcement"]}
