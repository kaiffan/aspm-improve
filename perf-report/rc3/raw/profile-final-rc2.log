SQL {"actor": "admin", "case": "dashboard", "ms": 0.18887600162997842, "sql": "SELECT \"dojo_answered_survey\".\"id\", \"dojo_answered_survey\".\"engagement_id\", \"dojo_answered_survey\".\"survey_id\", \"dojo_answered_survey\".\"assignee_id\", \"dojo_answered_survey\".\"responder_id\", \"dojo_answered_survey\".\"completed\", \"dojo_answered_survey\".\"answered_on\" FROM \"dojo_answered_survey\" WHERE (\"dojo_answered_survey\".\"assignee_id\" IS NULL AND \"dojo_answered_survey\".\"completed\" > %s AND (\"dojo_answered_survey\".\"engagement_id\" IS NULL OR \"dojo_answered_survey\".\"engagement_id\" IN (SELECT DISTINCT \"dojo_engagement\".\"id\" FROM \"dojo_engagement\")))", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/home/views.py:59:dashboard"]}
