SQL {"actor": "small", "case": "simple_metrics", "ms": 0.10812499749590643, "sql": "SELECT \"dojo_userannouncement\".\"id\", \"dojo_userannouncement\".\"announcement_id\", \"dojo_userannouncement\".\"user_id\", \"dojo_announcement\".\"id\", \"dojo_announcement\".\"message\", \"dojo_announcement\".\"style\", \"dojo_announcement\".\"dismissable\" FROM \"dojo_userannouncement\" LEFT OUTER JOIN \"dojo_announcement\" ON (\"dojo_userannouncement\".\"announcement_id\" = \"dojo_announcement\".\"id\") WHERE \"dojo_userannouncement\".\"user_id\" = %s LIMIT 21", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/metrics/views.py:230:simple_metrics", "/app/dojo/context_processors.py:101:bind_announcement"]}
