SQL {"actor": "admin", "case": "reports", "ms": 3.1291750019590836, "sql": "SELECT DISTINCT \"dojo_location\".\"id\", \"dojo_location\".\"created\", \"dojo_location\".\"updated\", \"dojo_location\".\"location_type\", \"dojo_location\".\"location_value\", COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") AS \"total_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"total_findings\", COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"active_findings\", COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") AS \"total_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"total_products\", COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) AS \"active_products\", (COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") AS \"total_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) - COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s)) AS \"mitigated_findings\", CASE WHEN (COALESCE((SELECT COUNT(DISTINCT V0.\"product_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_products\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT V1.\"id\" FROM \"dojo_product\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) > %s OR COALESCE((SELECT COUNT(DISTINCT V0.\"finding_id\") FILTER (WHERE (V0.\"status\" = %s)) AS \"active_findings\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\")) GROUP BY V0.\"location_id\" ORDER BY V0.\"location_id\" ASC LIMIT 1), %s) > %s) THEN %s ELSE %s END AS \"overall_status\" FROM \"dojo_location\" WHERE EXISTS(SELECT %s AS \"a\" FROM \"dojo_locationfindingreference\" V0 WHERE (V0.\"finding_id\" IN (SELECT V1.\"id\" FROM \"dojo_finding\" V1) AND V0.\"location_id\" = (\"dojo_location\".\"id\") AND V0.\"status\" = %s) LIMIT 1) ORDER BY \"dojo_location\".\"id\" ASC LIMIT 25", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/reports/ui/views.py:94:get", "/app/dojo/reports/widgets.py:368:get_option_form"]}
