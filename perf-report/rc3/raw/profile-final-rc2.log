SQL {"actor": "small", "case": "simple_metrics_cold", "ms": 0.2368340028624516, "sql": "SELECT \"django_content_type\".\"app_label\" AS \"content_type__app_label\", \"auth_permission\".\"codename\" AS \"codename\" FROM \"auth_permission\" INNER JOIN \"auth_group_permissions\" ON (\"auth_permission\".\"id\" = \"auth_group_permissions\".\"permission_id\") INNER JOIN \"django_content_type\" ON (\"auth_permission\".\"content_type_id\" = \"django_content_type\".\"id\") WHERE \"auth_group_permissions\".\"group_id\" IN (SELECT U0.\"id\" FROM \"auth_group\" U0 INNER JOIN \"auth_user_groups\" U1 ON (U0.\"id\" = U1.\"group_id\") WHERE U1.\"user_id\" = %s)", "stack": ["/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/metrics/views.py:230:simple_metrics", "/app/dojo/authorization/template_filters.py:16:has_global_permission", "/app/dojo/authorization/authorization.py:199:user_has_global_permission", "/app/dojo/authorization/authorization.py:66:user_has_configuration_permission"]}
