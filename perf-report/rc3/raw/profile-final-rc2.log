SQL {"actor": "small", "case": "users", "ms": 0.1710840006126091, "sql": "SELECT \"django_content_type\".\"app_label\" AS \"content_type__app_label\", \"auth_permission\".\"codename\" AS \"codename\" FROM \"auth_permission\" INNER JOIN \"auth_user_user_permissions\" ON (\"auth_permission\".\"id\" = \"auth_user_user_permissions\".\"permission_id\") INNER JOIN \"django_content_type\" ON (\"auth_permission\".\"content_type_id\" = \"django_content_type\".\"id\") WHERE \"auth_user_user_permissions\".\"user_id\" = %s", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/authorization/api_permissions.py:1393:has_permission"]}
