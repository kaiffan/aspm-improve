SQL {"actor": "admin", "case": "dashboard", "ms": 0.13670800035470165, "sql": "SELECT \"dojo_userannouncement\".\"id\", \"dojo_userannouncement\".\"announcement_id\", \"dojo_userannouncement\".\"user_id\", \"dojo_announcement\".\"id\", \"dojo_announcement\".\"message\", \"dojo_announcement\".\"style\", \"dojo_announcement\".\"dismissable\" FROM \"dojo_userannouncement\" LEFT OUTER JOIN \"dojo_announcement\" ON (\"dojo_userannouncement\".\"announcement_id\" = \"dojo_announcement\".\"id\") WHERE \"dojo_userannouncement\".\"user_id\" = %s LIMIT 21", "stack": ["/app/dojo/middleware.py:247:__call__", "/app/dojo/middleware.py:194:__call__", "/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/home/views.py:59:dashboard", "/app/dojo/context_processors.py:101:bind_announcement"]}
