SQL {"actor": "medium", "case": "endpoint_status", "ms": 1.3374009995459346, "sql": "SELECT COUNT(*) FROM (SELECT DISTINCT \"dojo_locationfindingreference\".\"id\" AS \"col1\", \"dojo_locationfindingreference\".\"created\" AS \"col2\", \"dojo_locationfindingreference\".\"updated\" AS \"col3\", \"dojo_locationfindingreference\".\"relationship\" AS \"col4\", \"dojo_locationfindingreference\".\"relationship_data\" AS \"col5\", \"dojo_locationfindingreference\".\"location_id\" AS \"col6\", \"dojo_locationfindingreference\".\"finding_id\" AS \"col7\", \"dojo_locationfindingreference\".\"test_id\" AS \"col8\", \"dojo_locationfindingreference\".\"auditor_id\" AS \"col9\", \"dojo_locationfindingreference\".\"audit_time\" AS \"col10\", \"dojo_locationfindingreference\".\"status\" AS \"col11\", \"dojo_locationfindingreference\".\"archived_at\" AS \"col12\", \"dojo_locationfindingreference\".\"archive_batch\" AS \"col13\", (SELECT V0.\"id\" AS \"id\" FROM \"dojo_locationproductreference\" V0 WHERE (V0.\"product_id\" IN (SELECT U0.\"id\" AS \"id\" FROM \"dojo_product\" U0 LEFT OUTER JOIN \"dojo_product_authorized_users\" U1 ON (U0.\"id\" = U1.\"product_id\") INNER JOIN \"dojo_product_type\" U3 ON (U0.\"prod_type_id\" = U3.\"id\") LEFT OUTER JOIN \"dojo_product_type_authorized_users\" U4 ON (U3.\"id\" = U4.\"product_type_id\") WHERE (U1.\"dojo_user_id\" = %s OR U4.\"dojo_user_id\" = %s)) AND V0.\"location_id\" = (\"dojo_locationfindingreference\".\"location_id\") AND V0.\"product_id\" = (\"dojo_engagement\".\"product_id\")) ORDER BY 1 ASC LIMIT 1) AS \"endpoint_reference_id\" FROM \"dojo_locationfindingreference\" INNER JOIN \"dojo_finding\" ON (\"dojo_locationfindingreference\".\"finding_id\" = \"dojo_finding\".\"id\") INNER JOIN \"dojo_test\" ON (\"dojo_finding\".\"test_id\" = \"dojo_test\".\"id\") INNER JOIN \"dojo_engagement\" ON (\"dojo_test\".\"engagement_id\" = \"dojo_engagement\".\"id\") INNER JOIN \"dojo_location\" ON (\"dojo_locationfindingreference\".\"location_id\" =