SQL {"actor": "small", "case": "endpoints", "ms": 0.26820599850907456, "sql": "SELECT %s AS \"a\" FROM \"dojo_product\" WHERE NOT (\"dojo_product\".\"id\" IN (SELECT DISTINCT U0.\"id\" AS \"pk\" FROM \"dojo_product\" U0 LEFT OUTER JOIN \"dojo_product_authorized_users\" U1 ON (U0.\"id\" = U1.\"product_id\") INNER JOIN \"dojo_product_type\" U3 ON (U0.\"prod_type_id\" = U3.\"id\") LEFT OUTER JOIN \"dojo_product_type_authorized_users\" U4 ON (U3.\"id\" = U4.\"product_type_id\") WHERE (U1.\"dojo_user_id\" = %s OR U4.\"dojo_user_id\" = %s))) LIMIT 1", "stack": ["/app/dojo/middleware.py:323:__call__", "/app/dojo/middleware.py:118:__call__", "/app/dojo/middleware.py:144:__call__", "/app/dojo/middleware.py:268:__call__", "/app/dojo/authorization/middleware.py:17:__call__", "/app/dojo/middleware.py:362:__call__", "/app/dojo/api_v2/prefetch/mixins.py:16:list", "/app/dojo/location/api/endpoint_compat.py:196:get_queryset", "/app/dojo/location/queries.py:213:annotate_tags_readable", "/app/dojo/location/queries.py:184:reads_every_product"]}
