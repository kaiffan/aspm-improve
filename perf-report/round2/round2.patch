+        empty = self._create_product("finding modes empty", with_finding=False)
+        for url, params in (
+            ("/api/v2/products/", {"id": f"{product.pk},{empty.pk}", "o": "id"}),
+            (f"/api/v2/products/{product.pk}/", {}),
