# Copy outside Git with mode 0600. Replace every placeholder; never commit credentials.
DD_DEBUG=False
DD_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
# Upgrades: preserve the existing credential encryption key; do not rotate blindly.
DD_CREDENTIAL_AES_256_KEY=REPLACE_WITH_EXACT_EXISTING_KEY
DD_ALLOWED_HOSTS=aspm.example.invalid
DD_SITE_URL=https://aspm.example.invalid
DD_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DATABASE_HOST:5432/REPLACE_DATABASE
DD_CELERY_BROKER_URL=redis://REPLACE_BROKER_HOST:6379/0
DD_CACHE_URL=redis://REPLACE_CACHE_HOST:6379/1
DD_SESSION_COOKIE_SECURE=True
DD_CSRF_COOKIE_SECURE=True
DD_ASPM_BRAND_NAME=ASPM
DD_ASPM_BRAND_MARK=dojo/img/aspm-mark.svg
DD_ASPM_FAVICON=dojo/img/aspm-mark.svg
DD_ASPM_SHOW_UPSTREAM_PROMOTIONS=False
